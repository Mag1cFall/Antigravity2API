# 管理端保存的设置中，LISTEN、AUTH_DIR、RUNTIME_DIR 重启服务后生效，其余项下一次请求生效；直接编辑本文件后重启服务生效

# 公开 API、管理 API 与管理端的监听地址；启动参数 --listen 覆盖
LISTEN=127.0.0.1:8017

# 公开 API key，逗号分隔多个；为空时不校验 key，只接受本机网页与非浏览器的请求；请求记录按 key 统计
API_KEYS=

# 账户目录；启动参数 --auth 覆盖
AUTH_DIR=auth

# 运行数据目录：请求账本 requests.db、日志 logs/、上传的 files/、生成媒体 media/、会话记录、模型目录与其他运行状态；启动参数 --runtime 覆盖
RUNTIME_DIR=runtime

# 上游 HTTP、HTTPS 或 SOCKS5 代理，逗号分隔的各项组成代理池（只填一个时也是）；为空时跟随系统代理（环境变量与 Windows 代理设置）；启动参数 --proxy 覆盖
PROXY=

# 系统提示档位：full 全保留、medium 中等、aggressive 激进、custom 自定义
SYSTEM_PROMPT=full

# custom 档位保留的官方段名，逗号分隔，按官方顺序拼接：identity、artifacts、conversation_transcript、guidelines、communication_style、slash_commands、messaging、subagents、skills、user_information
SYSTEM_PROMPT_SECTIONS=identity,guidelines,communication_style

# custom 档位的用户消息包装：full 官方完整包装，time 请求与本地时间，none 不包装
SYSTEM_PROMPT_WRAP=time

# 客户端模型名到目录模型 ID 的映射，逗号分隔多项，每项写成 别名:模型 ID，例如 claude-haiku-5-5:gemini-3.8-flash-low
MODEL_MAPPING=

# Chat Completions、Messages 正文与 Images url 格式中生成媒体的给出方式：inline 以 data URL 内联，url 保存到 RUNTIME_DIR/media/ 并以本服务 /media/ 链接给出
MEDIA_OUTPUT=inline

# 媒体链接使用的服务地址，例如 https://ai.example.com；为空时使用每个请求访问的地址
MEDIA_BASE_URL=

# 单账户同时处理的请求数
ACCOUNT_CONCURRENCY=2

# 账户调度策略：round-robin 轮询，fill-first 先用满一个账户
ROUTING_STRATEGY=round-robin

# 优先用低套餐账户的模型 ID，逗号分隔；同一优先级内依次先用 Free、Pro、Ultra 账户
PREFER_LOWER_TIER_MODELS=

# 等待首个上游事件与相邻两个上游事件之间的最长时长
REQUEST_TIMEOUT=5m

# 后台读取全部账户（含停用账户）额度的间隔，最短 1m，0 为不自动刷新
QUOTA_REFRESH_INTERVAL=15m

# 额度保留比例（0–99）：账户某个额度组的 5 小时或每周剩余比例不高于此百分比时调度跳过该组，直到该窗口重置；0 时只跳过已用尽的组
QUOTA_RESERVE_PERCENT=0

# 每次自动刷新额度后，为每周额度窗口尚未开始计时的就绪账户发一条 Hi，开始本周计时；同一账户的每个额度组 6 天内最多一次
WEEKLY_QUOTA_WARMUP=false

# 服务日志级别：debug、info、warn、error
LOG_LEVEL=info

# 服务日志格式：json 或 text
LOG_FORMAT=json

# 同时把服务日志写入 RUNTIME_DIR/logs/，单文件 10 MB 轮转
LOG_FILE=true

# 日志文件总量上限：保留 LOG_MAX_TOTAL_MB / 10 − 1 个轮转文件，超出时删除最旧的，不小于 20
LOG_MAX_TOTAL_MB=500

# 保存公开 API 的请求与响应正文和成功请求的上游尝试正文（失败请求的上游尝试正文总是保存），各截断到 64 KiB，各保留最近 1000 条
REQUEST_LOG_BODIES=false

# 远程访问管理端时的登录；本机回环访问免登录
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
